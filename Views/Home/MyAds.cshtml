@model List<Project_AutoHouse.Models.CarAd>
@{
    ViewData["Title"] = "Моите обяви";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h2 style="font-weight: 800; color: #1a237e;">Вашият гараж 🚗</h2>
        <span class="badge bg-dark">Общо: @Model.Count обяви</span>
    </div>

    @if (Model.Count == 0)
    {
        <div class="text-center p-5 border rounded bg-light">
            <h4>Все още нямате публикувани обяви.</h4>
            <a href="/Home/Create" class="btn btn-primary mt-3">Публикувай първата си обява</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var car in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm h-100 border-0" style="border-radius: 15px; overflow: hidden;">
                        <img src="@car.ImageUrl" class="card-img-top" style="height: 200px; object-fit: cover;">
                        <div class="card-body">
                            <h5 class="fw-bold">@car.Make @car.Model</h5>
                            <p class="text-primary fw-bold fs-5 mb-1">@car.Price.ToString("N0") лв.</p>

                            <p class="text-muted small mb-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-eye me-1" viewBox="0 0 16 16">
                                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z" />
                                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z" />
                                </svg>
                                @car.Views преглеждания
                            </p>

                            <hr>

                            <div class="d-flex justify-content-between align-items-center">
                                <a href="/Home/Details/@car.Id" class="btn btn-sm btn-outline-secondary">Преглед</a>

                                <form method="post" action="/Home/Delete/@car.Id" onsubmit="return confirm('Сигурни ли сте?')">
                                    <button type="submit" class="btn btn-sm btn-danger">Изтрий</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>