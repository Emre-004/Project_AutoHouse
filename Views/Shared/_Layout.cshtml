<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoHouse</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        /* Стил за навигацията горе */
        .navbar {
            background-color: #ffffff;
            border-bottom: 1px solid #e5e5e5;
            padding: 15px 0;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 24px;
            color: #1a1a1a;
        }

        .nav-link {
            color: #4a4a4a;
            font-weight: 500;
            margin-right: 15px;
        }

        .btn-publish {
            background-color: #2b5fe7;
            color: white;
            font-weight: 600;
            border-radius: 6px;
            padding: 8px 20px;
        }

            .btn-publish:hover {
                background-color: #1e4ac4;
                color: white;
            }
    </style>
</head>
<body>
    
    <div class="offcanvas offcanvas-start" tabindex="-1" id="sidebarMenu" aria-labelledby="sidebarMenuLabel" style="width: 300px; box-shadow: 2px 0 10px rgba(0,0,0,0.1);">
        <div class="offcanvas-header border-bottom py-3">
            <h4 class="offcanvas-title" id="sidebarMenuLabel" style="font-weight: 700; color: #111;">Меню</h4>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0">
            <div class="list-group list-group-flush" style="font-size: 15px; font-weight: 600;">
                <a href="/Home/Index" class="list-group-item list-group-item-action py-3 border-bottom text-dark">Начало / Търсене</a>

                <!-- Проверка дали потребителят е влязъл -->
                @if (!Project_AutoHouse.Controllers.HomeController.IsLoggedIn)
                {
                    <a href="/Home/Login" class="list-group-item list-group-item-action py-3 border-bottom text-dark">Вход / Регистрация</a>
                }
                else
                {
                    <a href="/Home/MyAds" class="list-group-item list-group-item-action py-3 border-bottom text-dark">Моите обяви</a>
                    <a href="/Home/Parking" class="list-group-item list-group-item-action py-3 border-bottom text-dark">Любими (Паркинг)</a>
                }

                <a href="/Home/Create" class="list-group-item list-group-item-action py-3 border-bottom text-dark">+ Публикувай обява</a>

                <!-- Статични линкове за красота (както са в cars.bg) -->
                <a href="#" class="list-group-item list-group-item-action py-3 border-bottom text-dark">Автокъщи / Търговци</a>
                <a href="#" class="list-group-item list-group-item-action py-3 border-bottom text-dark">Настройки</a>
                <a href="#" class="list-group-item list-group-item-action py-3 border-bottom text-dark">Въпроси и предложения</a>
                <a href="#" class="list-group-item list-group-item-action py-3 border-bottom text-dark">Контакт с EEE.auto</a>

                @if (Project_AutoHouse.Controllers.HomeController.IsLoggedIn)
                {
                    <a href="/Home/Logout" class="list-group-item list-group-item-action py-3 text-danger mt-auto border-top">Изход</a>
                }
            </div>
        </div>
    </div>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark shadow-sm" style="background-color: #1a237e; padding: 12px 20px;">
            <div class="container-fluid">

                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-white p-0 me-3 border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z" />
                        </svg>
                    </button>

                    <a class="navbar-brand d-flex align-items-center m-0" href="/Home/Index">
                        <img src="/images/LOGO.jpg" alt="Logo" style="height: 95px; width: 95px; object-fit: contain; margin-right: 15px; background: white; padding: 5px; border-radius: 50%; box-shadow: 0 4px 6px rgba(0,0,0,0.1);" />
                        <span style="font-weight: 2300; font-size: 24px; letter-spacing: -0.5px; color: white; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">EEE.auto</span>
                    </a>
                </div>

                <div class="d-flex align-items-center gap-3">

                    <a href="/Home/Parking" class="text-white opacity-75 hover-opacity-100 me-3" title="Моят Паркинг">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-heart-fill text-danger" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314z" />
                        </svg>
                    </a>

                    <div class="d-none d-md-block border-start border-light opacity-25" style="height: 20px;"></div>

                    <div class="d-flex gap-3 align-items-center">
                        @if (Project_AutoHouse.Controllers.HomeController.IsLoggedIn)
                        {
                            <span class="text-white-50 small">Здравей, <b class="text-white">@Project_AutoHouse.Controllers.HomeController.CurrentUserName</b></span>

                            <a class="text-white text-decoration-none small fw-bold mx-2" href="/Home/MyAds">Моите обяви</a>

                            <a class="btn btn-sm btn-outline-light border-0" href="/Home/Logout">Изход</a>
                        }
                        else
                        {
                            <a class="text-white text-decoration-none small fw-bold" href="/Home/Login">Вход</a>
                            <a class="text-white text-decoration-none small fw-bold border border-light rounded px-2 py-1" href="/Home/Register">Регистрация</a>
                        }

                        <a class="btn btn-primary fw-bold px-3 shadow-sm" style="background-color: #2979ff; border: none; border-radius: 6px;" href="/Home/Create">
                            Публикувай
                        </a>
                    </div>
                </div>

            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Добра практика за ASP.NET: Позволява добавяне на специфични скриптове в други страници -->
    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        function confirmDelete(event, form) {
            // Спираме формата да се изпрати веднага
            event.preventDefault();

            // Извикваме красивия прозорец
            Swal.fire({
                title: 'Сигурни ли сте?',
                text: "Тази обява ще бъде изтрита безвъзвратно!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545', // Червен цвят за бутона за изтриване
                cancelButtonColor: '#6c757d', // Сив цвят за отказ
                confirmButtonText: 'Да, изтрий я!',
                cancelButtonText: 'Отказ'
            }).then((result) => {
                // Ако потребителят е цъкнал "Да, изтрий я!"
                if (result.isConfirmed) {
                    form.submit(); // Чак тогава изпращаме формата към сървъра
                }
            })
        }
    </script>
</body>
</html>