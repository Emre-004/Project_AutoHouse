@model List<Project_AutoHouse.Models.CarAd>
@{
    ViewData["Title"] = "Моят Паркинг";
}

<div class="container mt-4">
    <div class="d-flex align-items-center mb-4">
        <h2 style="font-weight: 800; color: #dc3545;">Моят Паркинг ❤️</h2>
        <span class="ms-3 badge bg-danger rounded-pill">@Model.Count запазени</span>
    </div>

    <hr />

    @if (Model.Count == 0)
    {
        <div class="text-center p-5">
            <h4 class="text-muted">Паркингът е празен...</h4>
            <p>Добавете обяви, които ви харесват, за да ги видите тук.</p>
            <a href="/Home/Index" class="btn btn-primary">Към обявите</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var car in Model)
            {
                var firstImage = car.ImageUrl != null ? car.ImageUrl.Split('|')[0] : "/images/no-image.jpg";

                <div class="col-md-4 mb-4">
                    <div class="car-card">
                        <img src="@firstImage" style="width: 100%; height: 220px; object-fit: cover;" alt="@car.Make @car.Model" />

                        <div class="p-3">
                            <h5>@car.Make @car.Model</h5>
                            <h4 class="text-primary">@car.Price.ToString("N0") лв.</h4>
                            <a href="/Home/Details/@car.Id" class="btn btn-outline-primary btn-sm w-100">Виж детайли</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>